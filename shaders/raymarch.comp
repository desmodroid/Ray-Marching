#version 430

// Each workgroup is 16 x 16 x 1
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba32f) uniform image2D frame;

struct Material {
    float r;
    float g;
    float b;
    float reflectivity;
    float specularFactor;
};

layout(binding = 0, std430) buffer materialData {
	Material materials[];
};

uniform int screenWidth, screenHeight; // Window width and height in pixels
uniform float globalTime;
uniform vec3 eyePos, rayFwd, rayRgt, rayUp, lightPos;
uniform bool showMarchCount;
uniform bool showAO;
uniform float cubeAngle;
uniform samplerCube skyTexture;

// Ray constants
const int MAX_MARCHES = 256; // Max number of marches a single ray can do before we give up
const int MAX_BOUNCES = 2; // Max number of reflective bounces possible for one invocation
const float EPS = 1e-4; // Used as ray stopping criteria
const float INTERSECT_JUMP = 1e0; // How far a ray can jump to a nearby surface if it runs out of marches
const float INF = 1e5; // Used to represent out-of-bound distances
const float MAX_DISTANCE = 200.0; // Essentially the far plane distance
const float RAY_STEP = 0.01; // Initial ray stepping distance to get secondary rays off surfaces
const float MIN_REFLECTIVITY = 0.01; // Stop bouncing when net reflectivity drops below this proportion

// Lighting constants
const float AMBIENT_TERM = 0.2;
const vec3 lightColour = vec3(0.8, 0.6, 0.4); // Light colour is tinted orange by default

struct Ray {
    vec3 position;
    vec3 direction;
};

struct Hit {
    float distance; 
    int materialIndex;
    int materialIndex2;
    float t;   
};

Hit newHit(float distance, int materialIndex) {
    return Hit (distance, materialIndex, materialIndex, 0.0);
}

// SDF for a sphere with centre c and radius r
float sphereSDF(vec3 p, vec3 c, float r) {
	return length(p - c) - r;
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float boxSDF( vec3 p, vec3 b )
{
  vec3 q = abs(p) - b;
  return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0);
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float sdBoxFrame( vec3 p, vec3 b, float e )
{
       p = abs(p  )-b;
  vec3 q = abs(p+e)-e;
  return min(min(
    length(max(vec3(p.x,q.y,q.z),0.0))+min(max(p.x,max(q.y,q.z)),0.0),
    length(max(vec3(q.x,p.y,q.z),0.0))+min(max(q.x,max(p.y,q.z)),0.0)),
    length(max(vec3(q.x,q.y,p.z),0.0))+min(max(q.x,max(q.y,p.z)),0.0));
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float sdOctahedron( vec3 p, float s )
{
  p = abs(p);
  float m = p.x+p.y+p.z-s;
  vec3 q;
       if( 3.0*p.x < m ) q = p.xyz;
  else if( 3.0*p.y < m ) q = p.yzx;
  else if( 3.0*p.z < m ) q = p.zxy;
  else return m*0.57735027;
    
  float k = clamp(0.5*(q.z-q.y+s),0.0,s); 
  return length(vec3(q.x,q.y-s+k,q.z-k)); 
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float sdHexPrism( vec3 p, vec2 h )
{
  const vec3 k = vec3(-0.8660254, 0.5, 0.57735);
  p = abs(p);
  p.xy -= 2.0*min(dot(k.xy, p.xy), 0.0)*k.xy;
  vec2 d = vec2(
       length(p.xy-vec2(clamp(p.x,-k.z*h.x,k.z*h.x), h.x))*sign(p.y-h.x),
       p.z-h.y );
  return min(max(d.x,d.y),0.0) + length(max(d,0.0));
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float sdCutHollowSphere( vec3 p, float r, float h, float t )
{
  float w = sqrt(r*r-h*h);
  vec2 q = vec2( length(p.xz), p.y );
  return ((h*q.x<w*q.y) ? length(q-vec2(w,h)) : 
                          abs(length(q)-r) ) - t;
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float sdRoundedCylinder( vec3 p, float ra, float rb, float h )
{
  vec2 d = vec2( length(p.xz)-ra+rb, abs(p.y) - h + rb );
  return min(max(d.x,d.y),0.0) + length(max(d,0.0)) - rb;
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float sdVerticalCapsule( vec3 p, float h, float r )
{
  p.y -= clamp( p.y, 0.0, h );
  return length( p ) - r;
}


// SDF code below (opRepeat, opDifference, length2, length8, sdCylinder, sdTorus82, de)
// created by tholzer from https://jbaker.graphics/writings/DEC.html
#define opRepeat(p,c) (mod(p,c)-0.5*c)
#define opDifference(a,b) max(a,-b)

float length2( vec2 p ) {
return sqrt( p.x*p.x + p.y*p.y );
}
float length8( vec2 p ) {
p = p*p; p = p*p; p = p*p;
return pow( p.x + p.y, 1.0/8.0 );
}

float sdCylinder (in vec3 p, in vec2 h ){
vec2 d = abs(vec2(length(p.xz), p.y)) - h;
return min(max(d.x, d.y), 0.0) + length(max(d, 0.0)); }


float sdTorus82( vec3 p, vec2 t ){
vec2 q = vec2(length2(p.xz)-t.x, p.y);
return length8(q) - t.y;
}

float de( in vec3 pos){
return opDifference(sdTorus82(pos, vec2(0.20, 0.1)),
    sdCylinder (opRepeat (vec3 (atan(pos.x, pos.z)/6.2831
                                ,pos.y
                                ,0.02+0.5*length(pos))
                        ,vec3(0.05, 1.0, 0.05))
                ,vec2(0.02, 0.6)));
}
// end of tholzer's 

mat2 inverseRotMatrix(float angle) {
    float cosAngle = cos(angle);
    float sinAngle = sin(angle);
    return mat2(cosAngle, -sinAngle, sinAngle, cosAngle);
}

vec2 smooth_min(float a, float b, float k) {
    float u = k - min(abs(a-b), k);
    float s = u * u / (4*k);
    float t = (a < b) ? (2.0*s / k) : (1 - (2.0*s/k));
    return vec2(min(a,b) - s, t);
}

vec2 smooth_intersection(float a, float b, float k) {
    vec2 r = smooth_min(-a, -b, k);
    return vec2(-r.x, r.y);
}

vec2 smooth_subtraction(float a, float b, float k) {
    vec2 r = smooth_min(-a, b, k);
    return vec2(-r.x, r.y);
}

// Combines a number of SDF primitives into a scene
Hit sceneSDF(vec3 position) {
    Hit closestHit = Hit(INF, 0, 0, 0);
    float distance;

    distance = sphereSDF(position, vec3(0.0, 1.5, 1.0), 1.0);
    if (distance < closestHit.distance) closestHit = newHit(distance, 0);


    // CSG COMPOSED OF PRIMS
    // ----------------- box with the box frame subtracted ------------------------

    vec3 boxPos = position - vec3(3.0, 1.5, 0.0);
    distance = max(
        boxSDF(boxPos, vec3(0.5)),
        -sdBoxFrame(boxPos,  vec3(0.6), 0.1)
    );
    if (distance < closestHit.distance) closestHit = newHit(distance, 2);



    // --------------- this is the weird rotating cut box thingy -------------------
    vec3 stillBox = position - vec3(3, 1.5, 5.0);   // still box
    vec3 cutBox = stillBox;                        // rotating box
    cutBox.zx = inverseRotMatrix(cubeAngle) * cutBox.zx;

    float boxThing = max(
        boxSDF(stillBox, vec3(0.5)),                  
        sdBoxFrame(cutBox, vec3(0.6), 0.1)        
    );
    if (boxThing < closestHit.distance) closestHit = newHit(boxThing, 2);


    // ---------------- octahedron and weird shape thingy --------------------------------

    float y = 1.5 * cos(globalTime); 
    float octahedron = sdOctahedron(position - vec3(3.0, 2 + y, 5.0), 0.5);
    if (octahedron < closestHit.distance) closestHit = newHit(octahedron, 3);


    float plane = boxSDF(position - vec3(0.0, 0.5, 0.0), vec3(10.0, 0.1, 10.0)); 
    if (plane < closestHit.distance) closestHit = newHit(plane, 1);

    // some weird green thingy, im sorry if everything is messy
    vec3 idekPos = vec3(-3, 1.5, 5.0);
    float greenThingy = max(
        sdHexPrism(position - idekPos, vec2(0.5, 0.3)),
        sdCutHollowSphere(position - idekPos, 0.5, 0.2, 0.01)
    );
    if (greenThingy < closestHit.distance) closestHit = newHit(greenThingy, 2);
    
    
    // blend floor box and oct
    vec2 blendFloor = smooth_min(octahedron, plane, 0.3);
    vec2 blendGreen = smooth_min(octahedron, boxThing, 0.3);
    vec2 blend = blendFloor;
    int matOther = 1;                  // floor material
    if (blendGreen.x < blendFloor.x) {
        blend = blendGreen;
        matOther = 2;                  // green thingy material
    }
    if (blend.x < closestHit.distance) closestHit = Hit(blend.x, 3, matOther, blend.y);


    // complex shape
    const float scaleFactor = 1.5; 
    distance = scaleFactor * de((position - vec3(-4, 1.0, -1) )/ scaleFactor);
    if (distance < closestHit.distance) closestHit = newHit(distance, 0);

    distance = sdRoundedCylinder(position - vec3(-4, 0.75, -1), 0.8, 0.05, 0.15);
    if (distance < closestHit.distance) closestHit = newHit(distance, 0);

    distance = sdVerticalCapsule(position - vec3(-4, 0.9, -1), 0.5, 0.125);
    if (distance < closestHit.distance) closestHit = newHit(distance, 0);

    return closestHit;
    }

//Calculate the surface normal at point p by sampling 4 nearby distance values in a tetrahedral pattern
vec3 getNormal(vec3 p, float delta) {
    delta = max(EPS, delta); // Delta can not be lower than EPS
	vec2 e = vec2(delta, -delta);
	return normalize(
		e.xyy * sceneSDF(p + e.xyy).distance + 
		e.yyx * sceneSDF(p + e.yyx).distance + 
		e.yxy * sceneSDF(p + e.yxy).distance + 
		e.xxx * sceneSDF(p + e.xxx).distance);
}

// March a ray to find distance value of intersection. Returns distance of INF if no intersection found
//
// MARCH_PROP = 1.0 is fine for SDFs that are properly defined or only under-estimate distances. If you are using
// a SDF that ever over-estimates distances, you may need to reduce MARCH_PROP to avoid stepping inside the surface
const float MARCH_PROP = 1.0;
Hit intersection(Ray ray) {
    Hit hit = Hit(INF, 0, 0, 0);
    float totalDistance = RAY_STEP;
    int i = 0;
	for (; i < MAX_MARCHES && totalDistance < MAX_DISTANCE && hit.distance > EPS; i++) {
		hit = sceneSDF(ray.position + totalDistance*ray.direction);
		totalDistance += hit.distance*MARCH_PROP;
	}
    if (hit.distance <= EPS || (i == MAX_MARCHES && hit.distance <= INTERSECT_JUMP)) hit.distance = totalDistance;
    else hit.distance = INF; // we were not close to anything

    if (showMarchCount) hit.distance = float(i)/MAX_MARCHES;
	return hit;
}

// Calculates a shadow factor of 0.0 to 1.0. Only does hard shadows by default
float detectShadow(Ray shadowRay, float lightDistance) {
    Hit hit = Hit(INF, 0, 0, 0);
	float totalDistance = RAY_STEP;
    float shadowFactor = 1.0;
    const float k = 16.0;
    
	for (int i = 0; i < MAX_MARCHES && totalDistance < lightDistance && hit.distance > EPS; i++) {
		hit = sceneSDF(shadowRay.position + totalDistance*shadowRay.direction);

		//Soft shadows: Could calculate soft shadowing factor here
        shadowFactor = min(shadowFactor, k * hit.distance / totalDistance);


		totalDistance += hit.distance;
	}
    if (hit.distance <= EPS) shadowFactor = 0.0; // fully occluded
	return shadowFactor;
}

float ambient_occlusion(vec3 p, vec3 normal) {
    int samples = 5;
    float ao_factor = 1.0;
    for (float i = 1; i <= samples; i++)  {
        float jumpLength = i * RAY_STEP;
        float diff = jumpLength - sceneSDF(p + normal * jumpLength).distance;
        ao_factor -= diff * diff/jumpLength;
    }
    return clamp(ao_factor, 0.0, 1.0);
}


void main() {
    ivec2 screenCoords = ivec2(gl_GlobalInvocationID.xy);

    // Because we dispatch a number of workgroups (each sized 16x16), we commonly end up with some extra invocations. 
    // Make sure that they exit harmlessly:
    if (screenCoords.x >= screenWidth || screenCoords.y >= screenHeight) return;

    vec2 normCoords = vec2(float(screenCoords.x)/screenWidth, float(screenCoords.y)/screenHeight);

    Ray ray = Ray(eyePos, 
        normalize(rayFwd + mix(-rayRgt, rayRgt, normCoords.x) + mix(-rayUp, rayUp, normCoords.y)));

    // March the ray, and then up to MAX_BOUNCES reflected ray bounces. ray, colour, and netReflectivity should be updated each iteration as necessary.
    vec3 colour = vec3(0.0);
    float netReflectivity = 1.0;
	for (int depth = 0; depth < 1 + MAX_BOUNCES && netReflectivity >= MIN_REFLECTIVITY; depth++) {
        Hit hit = intersection(ray);

        if (showMarchCount) {
            colour = vec3(hit.distance);
            break;
        }
        
        if (hit.distance > MAX_DISTANCE) {
            const vec3 backgroundColour = texture(skyTexture, ray.direction).rgb;
            colour += netReflectivity*backgroundColour;
            netReflectivity = 0.0;
        } else {
            vec3 intersectPos = ray.position + hit.distance*ray.direction;

            vec3 viewVector = eyePos - intersectPos;
            float viewDistance = length(viewVector);
            viewVector = normalize(viewVector);

            vec3 lightVector = lightPos - intersectPos;
            float lightDistance = length(lightVector);
            lightVector = normalize(lightVector);

            vec3 halfwayVector = normalize(lightVector + viewVector);

            vec3 normal = getNormal(intersectPos, viewDistance/1e5);

            float diffuseTerm = max(dot(lightVector, normal), 0.0);
            float specularTerm = pow(max(dot(halfwayVector, normal), 0.0), 50.0);

            Ray shadowRay = Ray(intersectPos, lightVector);

            float shadowFactor = detectShadow(shadowRay, lightDistance);

            Material m1 = materials[hit.materialIndex];
            Material m2 = materials[hit.materialIndex2];

            vec3 materialColour  = mix(vec3(m1.r, m1.g, m1.b), vec3(m2.r, m2.g, m2.b), hit.t);
            float specularFactor = mix(m1.specularFactor, m2.specularFactor, hit.t);
            float reflectivity   = mix(m1.reflectivity,   m2.reflectivity,   hit.t);
            float ao = (showAO) ? ambient_occlusion(intersectPos, normal) : 1.0;
            

            vec3 phong = materialColour * AMBIENT_TERM * ao +
             ao * shadowFactor*lightColour*
             (materialColour * diffuseTerm 
             + specularFactor * specularTerm);

            colour += netReflectivity * phong;
            
            // Reflections: Could multiply netReflectivity by material reflectivity here instead
            netReflectivity *= reflectivity;

            if (netReflectivity > MIN_REFLECTIVITY) {
                vec3 r = reflect(ray.direction, normal);
                ray = Ray(intersectPos, r);
            }
        }
    }

    imageStore(frame, screenCoords, vec4(colour, 1.0));
}