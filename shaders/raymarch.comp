#version 430

// Each workgroup is 16 x 16 x 1
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba32f) uniform image2D frame;

struct Material {
    float r;
    float g;
    float b;
    float reflectivity;
    float specularFactor;
};

layout(binding = 0, std430) buffer materialData {
	Material materials[];
};

uniform int screenWidth, screenHeight; // Window width and height in pixels
uniform float globalTime;
uniform vec3 eyePos, rayFwd, rayRgt, rayUp, lightPos;
uniform bool showMarchCount;
uniform bool showAO;


// Ray constants
const int MAX_MARCHES = 256; // Max number of marches a single ray can do before we give up
const int MAX_BOUNCES = 2; // Max number of reflective bounces possible for one invocation
const float EPS = 1e-4; // Used as ray stopping criteria
const float INTERSECT_JUMP = 1e0; // How far a ray can jump to a nearby surface if it runs out of marches
const float INF = 1e5; // Used to represent out-of-bound distances
const float MAX_DISTANCE = 200.0; // Essentially the far plane distance
const float RAY_STEP = 0.01; // Initial ray stepping distance to get secondary rays off surfaces
const float MIN_REFLECTIVITY = 0.01; // Stop bouncing when net reflectivity drops below this proportion

// Lighting constants
const float AMBIENT_TERM = 0.2;
const vec3 lightColour = vec3(0.8, 0.6, 0.4); // Light colour is tinted orange by default

struct Ray {
    vec3 position;
    vec3 direction;
};

struct Hit {
    float distance;
    int materialIndex;
};

// SDF for a sphere with centre c and radius r
float sphereSDF(vec3 p, vec3 c, float r) {
	return length(p - c) - r;
}

// by Inigo quilez (https://iquilezles.org/articles/distfunctions/)
float boxSDF( vec3 p, vec3 b )
{
  vec3 q = abs(p) - b;
  return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0);
}

// Combines a number of SDF primitives into a scene
Hit sceneSDF(vec3 position) {
    Hit closestHit = Hit(INF, 0);
    float distance;

    distance = sphereSDF(position, vec3(0.0, 1.5, 1.0), 1.0);
    if (distance < closestHit.distance) closestHit = Hit(distance, 0);

    distance = boxSDF(position - vec3(0.0, 0.5, 0.0), vec3(5.0, 0.1, 5.0)); 
    if (distance < closestHit.distance) closestHit = Hit(distance, 1);
    return closestHit;
}

//Calculate the surface normal at point p by sampling 4 nearby distance values in a tetrahedral pattern
vec3 getNormal(vec3 p, float delta) {
    delta = max(EPS, delta); // Delta can not be lower than EPS
	vec2 e = vec2(delta, -delta);
	return normalize(
		e.xyy * sceneSDF(p + e.xyy).distance + 
		e.yyx * sceneSDF(p + e.yyx).distance + 
		e.yxy * sceneSDF(p + e.yxy).distance + 
		e.xxx * sceneSDF(p + e.xxx).distance);
}

// March a ray to find distance value of intersection. Returns distance of INF if no intersection found
//
// MARCH_PROP = 1.0 is fine for SDFs that are properly defined or only under-estimate distances. If you are using
// a SDF that ever over-estimates distances, you may need to reduce MARCH_PROP to avoid stepping inside the surface
const float MARCH_PROP = 1.0;
Hit intersection(Ray ray) {
    Hit hit = Hit(INF, 0);
    float totalDistance = RAY_STEP;
    int i = 0;
	for (; i < MAX_MARCHES && totalDistance < MAX_DISTANCE && hit.distance > EPS; i++) {
		hit = sceneSDF(ray.position + totalDistance*ray.direction);
		totalDistance += hit.distance*MARCH_PROP;
	}
    if (hit.distance <= EPS || (i == MAX_MARCHES && hit.distance <= INTERSECT_JUMP)) hit.distance = totalDistance;
    else hit.distance = INF; // we were not close to anything

    if (showMarchCount) hit.distance = float(i)/MAX_MARCHES;
	return hit;
}

// Calculates a shadow factor of 0.0 to 1.0. Only does hard shadows by default
float detectShadow(Ray shadowRay, float lightDistance) {
    Hit hit = Hit(INF, 0);
	float totalDistance = RAY_STEP;
    float shadowFactor = 1.0;
    const float k = 16.0;
    
	for (int i = 0; i < MAX_MARCHES && totalDistance < lightDistance && hit.distance > EPS; i++) {
		hit = sceneSDF(shadowRay.position + totalDistance*shadowRay.direction);

		//Soft shadows: Could calculate soft shadowing factor here
        shadowFactor = min(shadowFactor, k * hit.distance / totalDistance);


		totalDistance += hit.distance;
	}
    if (hit.distance <= EPS) shadowFactor = 0.0; // fully occluded
	return shadowFactor;
}

float ambient_occlusion(vec3 p, vec3 normal) {
    int samples = 5;
    float jumpLength;
    float diff;
    float ao_factor = 1.0;
    for (float i = 0; i < samples; i++)  {
        jumpLength = i * RAY_STEP;
        diff = jumpLength - sceneSDF(p + normal * jumpLength).distance;
        ao_factor -= diff * diff/jumpLength;
    }
    return clamp(ao_factor, 0.0, 1.0);
}


void main() {
    ivec2 screenCoords = ivec2(gl_GlobalInvocationID.xy);

    // Because we dispatch a number of workgroups (each sized 16x16), we commonly end up with some extra invocations. 
    // Make sure that they exit harmlessly:
    if (screenCoords.x >= screenWidth || screenCoords.y >= screenHeight) return;

    vec2 normCoords = vec2(float(screenCoords.x)/screenWidth, float(screenCoords.y)/screenHeight);

    Ray ray = Ray(eyePos, 
        normalize(rayFwd + mix(-rayRgt, rayRgt, normCoords.x) + mix(-rayUp, rayUp, normCoords.y)));

    // March the ray, and then up to MAX_BOUNCES reflected ray bounces. ray, colour, and netReflectivity should be updated each iteration as necessary.
    vec3 colour = vec3(0.0);
    float netReflectivity = 1.0;
	for (int depth = 0; depth < 1 + MAX_BOUNCES && netReflectivity >= MIN_REFLECTIVITY; depth++) {
        Hit hit = intersection(ray);

        if (showMarchCount) {
            colour = vec3(hit.distance);
            break;
        }
        
        if (hit.distance > MAX_DISTANCE) {
            const vec3 backgroundColour = vec3(0.8, 0.9, 1.0);
            colour += netReflectivity*backgroundColour;
            netReflectivity = 0.0;
        } else {
            vec3 intersectPos = ray.position + hit.distance*ray.direction;

            vec3 viewVector = eyePos - intersectPos;
            float viewDistance = length(viewVector);
            viewVector = normalize(viewVector);

            vec3 lightVector = lightPos - intersectPos;
            float lightDistance = length(lightVector);
            lightVector = normalize(lightVector);

            vec3 halfwayVector = normalize(lightVector + viewVector);

            vec3 normal = getNormal(intersectPos, viewDistance/1e5);

            float diffuseTerm = max(dot(lightVector, normal), 0.0);
            float specularTerm = pow(max(dot(halfwayVector, normal), 0.0), 50.0);

            Ray shadowRay = Ray(intersectPos, lightVector);

            float shadowFactor = detectShadow(shadowRay, lightDistance);

            Material m = materials[hit.materialIndex];
            vec3 materialColour = vec3(m.r, m.g, m.b);
            float specularFactor = m.specularFactor;

            float ao = (showAO) ? ambient_occlusion(intersectPos, normal) : 1.0;
            

            vec3 phong = materialColour * AMBIENT_TERM * ao +
             shadowFactor*lightColour*
             (materialColour * diffuseTerm 
             + specularFactor * specularTerm);

            colour += netReflectivity * phong;
            
            // Reflections: Could multiply netReflectivity by material reflectivity here instead
            netReflectivity *= m.reflectivity;

            if (netReflectivity > MIN_REFLECTIVITY) {
                vec3 r = reflect(ray.direction, normal);
                ray = Ray(intersectPos, r);
            }
        }
    }

    imageStore(frame, screenCoords, vec4(colour, 1.0));
}